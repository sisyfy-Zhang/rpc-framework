<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.feynman.rpc</groupId>
    <artifactId>rpc-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>rpc-demo</artifactId>
  <dependencies>
    <!-- RPC 接口定义 -->
    <dependency>
	    <groupId>com.feynman.rpc</groupId>
	    <artifactId>rpc-api</artifactId>
	</dependency>
    <!-- RPC 框架核心 -->
	<dependency>
	    <groupId>com.feynman.rpc</groupId>
	    <artifactId>rpc-core</artifactId>
	</dependency>
	<!-- Spring Boot 自动装配：application.yml 驱动配置 + @EnableRpc，替代手动拼 RpcProviderConfiguration -->
	<dependency>
	    <groupId>com.feynman.rpc</groupId>
	    <artifactId>rpc-spring-boot-starter</artifactId>
	</dependency>
	<!-- 提供端要向 ZK 注册：引入具体的 Registry SPI 实现（按需替换/追加为 rpc-registry-nacos） -->
	<dependency>
	    <groupId>com.feynman.rpc</groupId>
	    <artifactId>rpc-registry-zookeeper</artifactId>
	</dependency>
	<!-- 需要至少一个 Serializer SPI 实现在 classpath 上（按需替换/追加为 rpc-serialize-protobuf） -->
	<dependency>
	    <groupId>com.feynman.rpc</groupId>
	    <artifactId>rpc-serialize-fastjson2</artifactId>
	</dependency>
    <!-- Spring Boot -->
    <dependency>
	    <groupId>org.springframework.boot</groupId>
	    <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- Spring test -->
    <dependency>
	    <groupId>org.springframework</groupId>
	    <artifactId>spring-test</artifactId>
	    <scope>test</scope>
    </dependency>
    <dependency>
	    <groupId>org.junit.jupiter</groupId>
	    <artifactId>junit-jupiter</artifactId>
	    <scope>test</scope>
	</dependency>

    <!-- 日志：rpc-core 等库模块只依赖 slf4j-api（不强加绑定给使用者），
         真正的日志实现由这个"应用"模块自己选，这里选 logback。 -->
    <dependency>
	    <groupId>org.slf4j</groupId>
	    <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
	    <groupId>ch.qos.logback</groupId>
	    <artifactId>logback-classic</artifactId>
	    <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
