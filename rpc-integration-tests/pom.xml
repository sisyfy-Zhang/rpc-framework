<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.sisyfy-zhang</groupId>
    <artifactId>rpc-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>rpc-integration-tests</artifactId>
  <name>rpc-integration-tests</name>
  <description>跨模块集成测试与全仓架构规则：依赖全部实现模块，只有测试代码。ZooKeeper 用 curator-test 进程内
    TestingServer，不依赖 Docker 与本机中间件。</description>

  <properties>
    <!-- 只有测试代码，产物不需要安装 / 发布 -->
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- 不发布到 Maven Central：-Prelease 下也不出 sources / javadoc、不签名（central-publishing 另有 excludeArtifacts 名单，见根 pom） -->
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <gpg.skip>true</gpg.skip>
  </properties>

  <dependencies>
    <!-- 被测模块用 compile scope（本模块不安装、不发布，scope 对使用方没有影响）：jacoco:report-aggregate
         只汇总 compile / runtime / provided scope 的依赖，写成 test scope 会得到一份空报告。 -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rpc-core</artifactId>
    </dependency>
    <!-- rpc-core 的 test-jar 只含 RpcLeakCheckExtension 与它的 META-INF/services 注册：
         配合本模块 junit-platform.properties 的自动检测，对每个集成测试类断言 rpc- 线程归零、在途为零 -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rpc-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rpc-registry-zookeeper</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rpc-registry-nacos</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rpc-serialize-fastjson2</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rpc-serialize-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rpc-metrics-micrometer</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rpc-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rpc-examples</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.curator</groupId>
      <artifactId>curator-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 汇总覆盖率：本模块依赖的全部模块（main 类）× 全部模块测试产生的 exec（含本模块的集成测试）。
           报告在 target/site/jacoco-aggregate/（index.html、jacoco.xml、jacoco.csv）。includeCurrentProject=true
           是为了把本模块自己的 exec（集成测试）算进去——本模块没有 main 代码，测试类（含 ArchUnit 夹具）不计入。
           顺序有讲究：报告在 post-integration-test 生成，此时 target/classes 还是空的；之后才解包 core 的类供 check 用。 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>report-aggregate</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <configuration>
              <includeCurrentProject>true</includeCurrentProject>
            </configuration>
          </execution>
          <!-- 口径二的检查：合并全部模块的 exec，对 core 的类做 check。jacoco:check 只分析"本模块"的 classes 目录，
               所以生成报告之后（同为 post-integration-test，jacoco 插件声明在前先执行）把 rpc-core 的类解包进本模块的
               target/classes（本模块没有 main 代码，也不安装、不发布），verify 阶段再按合并后的 exec 检查。 -->
          <execution>
            <id>merge-all-modules</id>
            <phase>verify</phase>
            <goals>
              <goal>merge</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.basedir}/..</directory>
                  <includes>
                    <include>*/target/jacoco.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>check-core-aggregate-line-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
              <includes>
                <include>com/feynman/rpc/core/**</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${rpc.core.minLineCoverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-core-classes-for-coverage-check</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>rpc-core</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                  <includes>com/feynman/rpc/core/**/*.class</includes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
