<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>
  <!-- 坐标 groupId（io.github.sisyfy-zhang）与 Java 包名（com.feynman.rpc）不同：Maven Central 的 io.github.* 命名空间按 GitHub 账号验证。
       版本号：开发期 X.Y.Z-SNAPSHOT，发布时改成 X.Y.Z 并打 vX.Y.Z tag（docs/releasing.md）；rpc-bom 不继承本 pom，版本要一起改。 -->
  <groupId>io.github.sisyfy-zhang</groupId>
  <artifactId>rpc-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>rpc-parent</name>
  <description>Parent POM of rpc-framework, a Netty-based Java RPC framework with pluggable registry, serializer, load-balancing and cluster SPIs.</description>
  <!-- Central 必填元数据（name / description / url / licenses / developers / scm），所有子模块继承；
       child.*.inherit.append.path=false：子模块的 url / scm 不在末尾拼 /artifactId（仓库没有按模块的独立页面） -->
  <url>https://github.com/sisyfy-Zhang/rpc-framework</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>sisyfy-Zhang</id>
      <name>sisyfy-Zhang</name>
      <email>fyenmanc@gmail.com</email>
    </developer>
  </developers>
  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/sisyfy-Zhang/rpc-framework.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/sisyfy-Zhang/rpc-framework.git</developerConnection>
    <url>https://github.com/sisyfy-Zhang/rpc-framework</url>
    <tag>HEAD</tag>
  </scm>
  <modules>
  	<module>rpc-bom</module>
  	<module>rpc-core</module>
  	<module>rpc-registry-tck</module>
  	<module>rpc-registry-zookeeper</module>
  	<module>rpc-registry-nacos</module>
  	<module>rpc-serialize-fastjson2</module>
  	<module>rpc-serialize-protobuf</module>
  	<module>rpc-metrics-micrometer</module>
  	<module>rpc-spring-boot-starter</module>
  	<module>rpc-examples</module>
  	<module>rpc-integration-tests</module>
  	<module>rpc-benchmark</module>
  	<module>rpc-bench-e2e</module>
  	<module>rpc-bench-compare-grpc</module>
  	<module>rpc-bench-compare-dubbo</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <netty.version>4.1.136.Final</netty.version>
    <spring.version>7.0.8</spring.version>
    <junit-bom.version>6.1.2</junit-bom.version>
    <jackson-bom.version>2.20.2</jackson-bom.version> <!-- Testcontainers 2.x 只 shade 了 jackson-databind/core，jackson-annotations 走 classpath；docker-java-api 3.7.1 要 2.20，nacos-client 2.4.3 传递的 2.13.5 按就近原则胜出，CI 有 Docker 时 NoSuchFieldError -->
    <fastjson2.version>2.0.60</fastjson2.version>
    <slf4j.version>2.0.17</slf4j.version> <!-- 1.7.x 的 StaticLoggerBinder 机制和 logback-classic 1.5.x（基于 SLF4J 2.x ServiceLoader）不兼容，绑定了也不生效 -->
    <zookeeper.version>3.9.4</zookeeper.version>
    <curator.version>5.8.0</curator.version> <!-- 5.2.0 的 curator-test 和 zookeeper 3.9.4 有二进制不兼容（IncompatibleClassChangeError），升到 5.8.0 修复 -->
    <protostuff.version>1.8.0</protostuff.version>
    <nacos-client.version>2.4.3</nacos-client.version>
    <logback.version>1.5.34</logback.version> <!-- 与 Spring Boot 4.1.0 的 spring-boot-starter-logging 对齐：1.5.13 不认识 Boot 4 defaults.xml 里 conversionRule 的 class 属性，%clr 解析失败 -->
    <spring-boot.version>4.1.0</spring-boot.version> <!-- 基于 Spring Framework 7.x，与本项目锁定的 spring.version 匹配 -->
    <archunit.version>1.3.2</archunit.version>
    <awaitility.version>4.3.0</awaitility.version>
    <jqwik.version>1.10.2</jqwik.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <jacoco.version>0.8.14</jacoco.version>
    <!-- rpc-bench-e2e：延迟直方图与口径卡解析（只用 SafeConstructor 加载成 Map，不反序列化到 Bean） -->
    <hdrhistogram.version>2.2.2</hdrhistogram.version>
    <snakeyaml.version>2.7</snakeyaml.version>
    <!-- rpc-metrics-micrometer：与 Spring Boot 4.1 管理的 Micrometer 同一条 1.17 线（starter 的 optional Actuator 也走它），
         避免同一个 classpath 上 Boot 的指标自动配置与本模块各拿一个 Micrometer 小版本 -->
    <micrometer.version>1.17.1</micrometer.version>
    <!-- 对比对象（rpc-bench-compare-grpc）：grpc-java 当前稳定版（1.85.0，2026-10-14），grpc-protobuf 1.85.0 依赖 protobuf-java 3.25.9，
         protoc 用同一版本生成代码（生成代码与运行时同一条 3.25 线）。protoc / protoc-gen-grpc-java 由 ascopes 的
         protobuf-maven-plugin 按平台从 Maven Central 取（Windows 与 Linux 同一份配置，不需要 os-maven-plugin 扩展）。 -->
    <grpc.version>1.85.0</grpc.version>
    <protobuf.version>3.25.9</protobuf.version>
    <protobuf-maven-plugin.version>5.1.11</protobuf-maven-plugin.version>
    <!-- 对比对象（rpc-bench-compare-dubbo）：Dubbo 3.3 线当前稳定版（3.3.6，2025-10-17），all-in-one 的 org.apache.dubbo:dubbo。
         它声明依赖 netty-all 4.2.2.Final（未 shade）；本仓库在下面统一管理 netty-all 4.1.136.Final，Dubbo 模块也解析到 4.1.136
         （dependency:tree -Dverbose 实证：4.2.2 omitted；3.3.6 的 remoting / triple 代码不引用 4.2 才有的 IoHandler 系 API，测试与压测在 4.1.136 上跑通）。
         这样同一个 JVM（harness + Dubbo 客户端）里只有一份 Netty，与本框架同一版本。 -->
    <dubbo.version>3.3.6</dubbo.version>
    <!-- -DskipTests 时 JaCoCo 全部跳过（prepare-agent / report / check）：没有跑测试就没有 exec，check 只会误报或白跑。
         写成 jacoco.skip 的默认值而不是插件的 <skip>${skipTests}</skip>：后者会覆盖插件对 jacoco.skip 的绑定，
         让 CI 与 paranoid 命令里的 -Djacoco.skip=true 失效；命令行的 -Djacoco.skip=... 仍然优先。 -->
    <skipTests>false</skipTests>
    <jacoco.skip>${skipTests}</jacoco.skip>
    <!-- A0-9：rpc-core 行覆盖率下限（core 自身单元测试、以及全部模块测试的聚合结果各检查一次） -->
    <rpc.core.minLineCoverage>0.70</rpc.core.minLineCoverage>
    <!-- surefire 的 JVM 参数：jacoco:prepare-agent 把探针 agent 写进这个属性；默认空值让跳过 JaCoCo 时 @{argLine} 也能解析。
         额外参数（如 -Dio.netty.leakDetection.level=paranoid）用 -DargLine=... 传入，见 surefire 配置的注释。 -->
    <argLine></argLine>
    <!-- 发布（-Prelease）用插件，只在 release profile 里生效 -->
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <!-- rpc-bom 不继承本 pom，它的 release profile 里写死了同一个版本，升级时两处一起改。
         至少 0.12.0：0.11.x 在 Maven 3.10（resolver 2）下暂存目录里会留下 maven-metadata-local.xml 与 _remote.repositories，
         被打进 bundle，Central 校验失败 -->
    <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 对比对象 gRPC：grpc-netty-shaded / grpc-protobuf / grpc-stub 同一版本线（只用于 rpc-bench-compare-grpc） -->
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <!-- 对比对象 Dubbo（只用于 rpc-bench-compare-dubbo） -->
      <dependency>
        <groupId>org.apache.dubbo</groupId>
        <artifactId>dubbo</artifactId>
        <version>${dubbo.version}</version>
      </dependency>

      <!-- micrometer-core / micrometer-registry-prometheus 等同一版本线 -->
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-bom</artifactId>
        <version>${micrometer.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-all</artifactId>
        <version>${netty.version}</version>
      </dependency>

      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-context</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-core</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-test</artifactId>
        <version>${spring.version}</version>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>com.alibaba.fastjson2</groupId>
        <artifactId>fastjson2</artifactId>
        <version>${fastjson2.version}</version>
      </dependency>

      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>

      <dependency>
        <groupId>org.apache.zookeeper</groupId>
        <artifactId>zookeeper</artifactId>
        <version>${zookeeper.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.curator</groupId>
        <artifactId>curator-framework</artifactId>
        <version>${curator.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.curator</groupId>
        <artifactId>curator-recipes</artifactId>
        <version>${curator.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.curator</groupId>
        <artifactId>curator-test</artifactId>
        <version>${curator.version}</version>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>commons-lang</groupId>
        <artifactId>commons-lang</artifactId>
        <version>2.4</version>
      </dependency>

      <!-- Protostuff：通过运行时推导 schema 实现真正的 Protobuf 线上格式编码，不需要 .proto 文件/
           代码生成。原生 google protobuf-java 要求每个消息类型都是生成出来的 Message 子类，
           不适合需要处理任意 POJO 参数/返回值的通用 RPC 序列化器。 -->
      <dependency>
        <groupId>io.protostuff</groupId>
        <artifactId>protostuff-core</artifactId>
        <version>${protostuff.version}</version>
      </dependency>
      <dependency>
        <groupId>io.protostuff</groupId>
        <artifactId>protostuff-runtime</artifactId>
        <version>${protostuff.version}</version>
      </dependency>

      <dependency>
        <groupId>com.alibaba.nacos</groupId>
        <artifactId>nacos-client</artifactId>
        <version>${nacos-client.version}</version>
      </dependency>

      <!-- rpc-core/rpc-registry-*/rpc-serialize-* 只依赖 slf4j-api（库的通用规则：绝不强制给
           使用方绑定具体日志实现）；logback-classic 在这里只作为*运行时*选择给实际应用
           （如 rpc-examples）使用，和任何真实应用的做法一样。 -->
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>

      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot</artifactId>
        <version>${spring-boot.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-autoconfigure</artifactId>
        <version>${spring-boot.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter</artifactId>
        <version>${spring-boot.version}</version>
      </dependency>
      <!-- 仅供 starter 以 optional 方式条件装配健康指示器（Boot 4 的 HealthIndicator 在 spring-boot-health，随它引入） -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-actuator</artifactId>
        <version>${spring-boot.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-configuration-processor</artifactId>
        <version>${spring-boot.version}</version>
        <optional>true</optional>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-test</artifactId>
        <version>${spring-boot.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- 架构规则测试（core 无 Spring、无 System.setProperty、无可变静态状态） -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- 异步条件等待（注册节点出现/消失、线程退出），替代手写 sleep 轮询 -->
      <dependency>
        <groupId>org.awaitility</groupId>
        <artifactId>awaitility</artifactId>
        <version>${awaitility.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- 基于属性的测试：协议编解码器的随机往返与随机字节模糊测试（只在 test scope） -->
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- 需要真实中间件（Nacos 等）的测试用 Testcontainers 起容器，按 Docker 是否可用门控（DESIGN 3.7）。
           只用核心模块：门控与容器生命周期由 Registry 契约测试的启停钩子管理，不需要 JUnit 扩展。 -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>${testcontainers.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- 端到端压测 harness（rpc-bench-e2e）专用 -->
      <dependency>
        <groupId>org.hdrhistogram</groupId>
        <artifactId>HdrHistogram</artifactId>
        <version>${hdrhistogram.version}</version>
      </dependency>
      <dependency>
        <groupId>org.yaml</groupId>
        <artifactId>snakeyaml</artifactId>
        <version>${snakeyaml.version}</version>
      </dependency>

      <!-- 本项目自己的模块，方便子模块间互相依赖时不用重复写 version -->
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-registry-tck</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-registry-zookeeper</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-registry-nacos</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-serialize-fastjson2</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-serialize-protobuf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-metrics-micrometer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-examples</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- 对比模块（rpc-bench-compare-*）实现 harness 的公开 SPI（CallTarget / CallTargetProvider） -->
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-bench-e2e</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
          <configuration>
            <!-- 探针类（类名以 ProbeTest 结尾，并标 @Tag("probe")）会改 Protostuff 全局 IdStrategy，默认不跑，用 -Pprobe 单独运行。
                 不用 excludedGroups：没有 JUnit 依赖的模块（如 rpc-benchmark）一配 groups/excludedGroups，surefire 就直接构建失败。 -->
            <excludes>
              <exclude>**/*ProbeTest.java</exclude>
              <exclude>**/*$*</exclude>
            </excludes>
            <!-- @{argLine} 是 surefire 的延迟替换，取 jacoco:prepare-agent 写进项目属性的值（JaCoCo agent）；
                 ${argLine} 在模型插值时取值，命令行 -DargLine=... 优先于项目属性，所以用户追加的 JVM 参数
                 （如 -Dio.netty.leakDetection.level=paranoid）走这一半。只写 @{argLine} 时 -DargLine 会被静默丢掉。 -->
            <argLine>@{argLine} ${argLine}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <!-- 所有 jar 的 MANIFEST 带 Implementation-Title / Version（取 name / version）与 Implementation-Vendor；
             各发布模块在自己的 pom 里给主 jar（default-jar）加 Automatic-Module-Name（= 根包名），
             放在模块路径上时模块名稳定，不随 jar 文件名变化。PublishedJarManifestTest 核对。 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
          <configuration>
            <archive>
              <manifest>
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              </manifest>
              <manifestEntries>
                <Implementation-Vendor>sisyfy-Zhang</Implementation-Vendor>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.7.0</version>
        </plugin>
        <plugin>
          <groupId>io.github.ascopes</groupId>
          <artifactId>protobuf-maven-plugin</artifactId>
          <version>${protobuf-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- 覆盖率（A0-9）：每个模块的测试都挂 JaCoCo agent，exec 写在各自的 target/jacoco.exec；
           rpc-integration-tests 用 report-aggregate 汇总全部模块（集成测试覆盖到的 core 代码也算进 core），
           rpc-core 自身用 check 守住行覆盖率下限。 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- mvn test -Pprobe：只跑探针类（test 参数覆盖 includes/excludes），没有探针类的模块不报错 -->
      <id>probe</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <configuration>
                <test>*ProbeTest</test>
                <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
    <profile>
      <!-- 发布到 Maven Central（docs/releasing.md）：mvn -Prelease -DskipTests deploy。
           发布面 = rpc-parent、rpc-bom 与 8 个库模块；示例 / 集成测试 / 压测模块在各自 pom 里设了
           maven.deploy.skip / maven.source.skip / maven.javadoc.skip / gpg.skip，并列在下面的 excludeArtifacts 里。 -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <!-- 只放过"缺注释"（missing），其余 doclint 检查（语法、引用、HTML、可访问性）照常报错并让构建失败 -->
              <doclint>all,-missing</doclint>
              <encoding>UTF-8</encoding>
              <docencoding>UTF-8</docencoding>
              <charset>UTF-8</charset>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <!-- 口令从环境变量 MAVEN_GPG_PASSPHRASE 读（插件缺省行为），不写进 pom / settings.xml；
                   loopback 让 gpg 不弹 pinentry（CI 与无 TTY 环境）。用哪把钥匙：-Dgpg.keyname=<id>，缺省为钥匙环里的默认私钥。 -->
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <!-- settings.xml 里 server id = central（用户名 / 密码 = Central Portal 的 user token），CI 由 setup-java 生成 -->
              <publishingServerId>central</publishingServerId>
              <!-- 只上传并等到校验通过；是否发布由人在 Central Portal 上点 Publish -->
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
              <!-- 本插件以扩展方式接管所有模块的 deploy，不看 maven.deploy.skip：不发布的模块必须按 artifactId 排除 -->
              <excludeArtifacts>
                <artifact>rpc-examples</artifact>
                <artifact>rpc-integration-tests</artifact>
                <artifact>rpc-benchmark</artifact>
                <artifact>rpc-bench-e2e</artifact>
                <artifact>rpc-bench-compare-grpc</artifact>
                <artifact>rpc-bench-compare-dubbo</artifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
