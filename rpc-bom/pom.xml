<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- 物料清单（BOM）：使用方 <scope>import</scope> 后，各 rpc-* 模块不用再写版本（README「模块」节有用法）。
       故意不继承 rpc-parent：被 import 时 Maven 会把 BOM 的整个 dependencyManagement（含从父 pom 继承来的）并进使用方，
       继承 rpc-parent 会把本仓库锁定的 Netty / Spring / Jackson / Nacos 等第三方版本一并强加给使用方。
       因此 groupId / version / Central 元数据在这里各写一份；发布改版本时与根 pom 一起改（docs/releasing.md）。 -->
  <groupId>io.github.sisyfy-zhang</groupId>
  <artifactId>rpc-bom</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>rpc-bom</name>
  <description>Bill of materials that pins the versions of all published rpc-framework modules.</description>
  <url>https://github.com/sisyfy-Zhang/rpc-framework</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>sisyfy-Zhang</id>
      <name>sisyfy-Zhang</name>
      <email>fyenmanc@gmail.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/sisyfy-Zhang/rpc-framework.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/sisyfy-Zhang/rpc-framework.git</developerConnection>
    <url>https://github.com/sisyfy-Zhang/rpc-framework</url>
    <tag>HEAD</tag>
  </scm>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-registry-tck</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-registry-zookeeper</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-registry-nacos</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-serialize-fastjson2</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-serialize-protobuf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-metrics-micrometer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rpc-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    <profile>
      <!-- 与根 pom 的 release profile 同名、同插件版本（这里不继承根 pom 的属性，只能写死）：
           pom 打包没有 sources / javadoc，只需签名与交给 central-publishing 打包上传 -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
