<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 框架自身的注册 / 摘除 / 地址变更日志保留，便于从测试输出里看清启停时序 -->
    <logger name="io.github.sisyfyzhang.steadyrpc" level="INFO" />

    <root level="WARN">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
