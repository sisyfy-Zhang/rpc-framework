<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.sisyfy-zhang</groupId>
    <artifactId>steadyrpc-parent</artifactId>
    <version>2.0.0</version>
  </parent>
  <artifactId>steadyrpc-serialize-fastjson2</artifactId>
  <name>steadyrpc-serialize-fastjson2</name>
  <description>Optional Serializer SPI implementation backed by fastjson2 (SPI name fastjson2); the default serializer is protobuf (steadyrpc-serialize-protobuf).</description>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>steadyrpc-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.alibaba.fastjson2</groupId>
      <artifactId>fastjson2</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <!-- 只给主 jar：模块路径上的模块名（根包名），与 jar 文件名无关 -->
            <id>default-jar</id>
            <configuration>
              <archive>
                <manifestEntries>
                  <Automatic-Module-Name>io.github.sisyfyzhang.steadyrpc.serialize.fastjson2</Automatic-Module-Name>
                </manifestEntries>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
