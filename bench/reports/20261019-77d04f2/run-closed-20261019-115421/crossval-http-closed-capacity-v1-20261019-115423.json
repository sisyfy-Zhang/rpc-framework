      "connections": 64,
      "connection_model": "closed: one connection per virtual user (pool = load.concurrency); one in-flight request per connection",
      "http_client": "netty HttpClientCodec + HttpObjectAggregator(8MiB), keep-alive, no pipelining",
      "io_transport": "epoll",
