          "size": 1024
        },
        "serializer": "protobuf",
        "providers": 1
      },
      "load": {
        "model": "closed",
        "concurrency": 64,
        "rate": null,
        "duration": "60s",
        "duration_ms": 60000.0,
        "warmup": "20s",
