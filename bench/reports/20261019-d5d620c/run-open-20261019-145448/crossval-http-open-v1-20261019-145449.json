  "profile": {
    "id": "crossval-http-open-v1",
    "parsed": {
      "profile": "crossval-http-open-v1",
      "question": "校验 harness 开环的达成吞吐、服务时间与节拍质量",
      "target": {
        "transport": "http",
        "service": "BenchService#echo",
        "method": "echo",
        "payload": {
          "kind": "bytes",
          "size": 1024
        },
        "serializer": null,
        "providers": 1,
        "http": {
          "url": "http://127.0.0.1:19180/echo",
          "connections": 64
        }
      },
      "load": {
        "model": "open",
        "concurrency": null,
        "rate": 5000,
        "duration": "60s",
        "duration_ms": 60000.0,
        "warmup": "20s",
        "warmup_ms": 20000.0,
        "steady_window": ["20s", "60s"],
        "steady_window_ms": [20000.0, 60000.0],
        "rounds": 3,
        "timeout": "1s",
        "timeout_ms": 1000.0,
        "inflight_cap": 10000
      },
      "isolation": {
        "client_process": "separate_jvm",
        "server_process": "separate_jvm",
        "same_host": true,
        "registry": "none (direct HTTP URL)"
      },
      "measure": {
        "histogram": {
          "significant_digits": 3,
          "max": "10s",
          "max_ms": 10000.0
        },
        "report": ["throughput", "p50", "p95", "p99", "p999", "max", "errors_by_status"]
      },
      "assert": [
        {
          "key": "errors_max",
          "metric": "errors",
          "bound": "max",
          "threshold": "0"
        }
      ]
    },
    "raw_yaml": "# 口径卡（harness 校验卡）：不是框架的性能卡。同一个 HTTP 目标（bench server --http-port 的 POST /echo）分别用 harness 与\n# wrk2 -U 打，校验 harness 的开环发压与测量：达成吞吐、服务时间 vs 未修正延迟、发出滞后（docs/benchmarking.md「交叉验证」）。\n# 由 bench/bin/crossval.sh --mode open 驱动；改动口径请复制成新 id（-v2），不要原地改。\nprofile: crossval-http-open-v1\nquestion: 校验 harness 开环的达成吞吐、服务时间与节拍质量\ntarget:\n  transport: http\n  service: BenchService#echo\n  payload: { kind: bytes, size: 1024 }\n  http: { url: \"http://127.0.0.1:19180/echo\", connections: 64 }\nload:\n  model: open\n  rate: 5000\n  duration: 60s\n  warmup: 20s\n  steady_window: [20s, 60s]\n  rounds: 3\n  timeout: 1s\nisolation:\n  client_process: separate_jvm\n  server_process: separate_jvm\n  same_host: true\n  registry: none (direct HTTP URL)\nmeasure:\n  histogram: { significant_digits: 3, max: 10s }\n  report: [throughput, p50, p95, p99, p999, max, errors_by_status]\nassert:\n  errors_max: 0\n"
  },
  "run": {
    "command": "rpc-bench-e2e run --profile /home/yifan/rpc-bench/bench/profiles/crossval-http-open-v1.yaml --out bench/reports/20261019-d5d620c/run-open-20261019-145448 --label baseline",
    "target": {
      "transport": "http",
      "mode": "http",
      "address": "http://127.0.0.1:19180/echo",
      "providers": ["127.0.0.1:19180"],
      "connections": 64,
      "connection_model": "open: pool of target.http.connections; one in-flight request per connection; no idle connection at the scheduled time -> queue (FIFO) for the next idle one, latency still from the scheduled time; in-flight cap (queued + sent) = rate x timeout x 2",
      "http_client": "netty HttpClientCodec + HttpObjectAggregator(8MiB), keep-alive, no pipelining",
      "io_transport": "epoll",
      "io_threads": 5,
      "timeout_check": "sweep every 10ms",
      "retries": 0,
      "pre_warmup_calls_per_connection": 200,
      "call_style": "sync: the calling virtual thread writes one HTTP/1.1 request and waits for its response",
      "metrics_filter": false
    }
  },
