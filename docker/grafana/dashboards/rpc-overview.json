            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rpc-prometheus"
          },
          "expr": "sum by (job) (rpc_server_connections{job=~\"$job\"})",
          "legendFormat": "server {{job}}",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rpc-prometheus"
          },
          "expr": "sum by (job) (rpc_client_connections{job=~\"$job\"})",
          "legendFormat": "client {{job}}",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "row",
      "title": "错误码分布",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "服务端错误码（所选时间范围）",
      "description": "sum by (status) (increase(rpc_server_calls_seconds_count{status!=\"OK\"}[$__range]))",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "rpc-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "所选时间范围内没有错误",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rpc-prometheus"
          },
          "expr": "sum by (status) (increase(rpc_server_calls_seconds_count{job=~\"$job\",status!=\"OK\"}[$__range]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "客户端错误码（所选时间范围）",
      "description": "sum by (status) (increase(rpc_client_calls_seconds_count{status!=\"OK\"}[$__range]))；TIMEOUT / TRANSPORT_FAILURE 只在客户端出现。",
      "id": 12,
      "datasource": {
