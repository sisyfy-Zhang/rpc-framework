<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.feynman.rpc</groupId>
    <artifactId>rpc-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>rpc-serialize-protobuf</artifactId>
  <name>rpc-serialize-protobuf</name>
  <description>Serializer SPI implementation using Protobuf wire format via Protostuff's runtime
    schema derivation, so it can serialize arbitrary POJOs generically like the RPC layer needs
    (no .proto schema/codegen step, unlike raw protobuf-java's generated Message classes).</description>
  <dependencies>
    <dependency>
      <groupId>com.feynman.rpc</groupId>
      <artifactId>rpc-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.protostuff</groupId>
      <artifactId>protostuff-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.protostuff</groupId>
      <artifactId>protostuff-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
