<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.sisyfy-zhang</groupId>
    <artifactId>rpc-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>rpc-registry-tck</artifactId>
  <name>rpc-registry-tck</name>
  <!-- Registry SPI 的契约测试套件（TCK）：抽象 JUnit 测试基类 RegistryContractTest。 每个 RegistryFactory 实现（本仓库的 ZooKeeper / Nacos，或第三方实现）在自己的 test 里继承它、 提供工厂与后端启停钩子，即可跑同一套用例。测试代码放在 src/main 是因为它是给别人的测试继承的库。 -->
  <description>Contract test kit (an abstract JUnit base class) that any Registry SPI implementation extends to run the same registry test suite.</description>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rpc-core</artifactId>
    </dependency>
    <!-- compile scope：使用方在自己的 test scope 引入本模块，这些依赖随之进入它们的测试类路径 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- 本模块自测：用一个进程内参考实现跑一遍契约，证明套件本身可用（不依赖任何真实后端） -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <!-- 只给主 jar：模块路径上的模块名（根包名），与 jar 文件名无关 -->
            <id>default-jar</id>
            <configuration>
              <archive>
                <manifestEntries>
                  <Automatic-Module-Name>com.feynman.rpc.registry.tck</Automatic-Module-Name>
                </manifestEntries>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
